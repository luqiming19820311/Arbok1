{
  "name": "arbok",
  "version": "0.2.0",
  "private": true,
  "description": "Arbok — 支持 YouTube、哔哩哔哩、播客，配中文字幕、翻译和播报、AI 导读、AI 问答与笔记功能",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/luqiming19820311/Arbok1.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "dist:prepare": "npm run build && node scripts/prepare-standalone.mjs",
    "dist:mac": "npm run dist:prepare && electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "com.luqiming.arbok",
    "productName": "Arbok",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.education",
      "icon": "resources/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Arbok ${version}",
      "artifactName": "Arbok-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "luqiming19820311",
        "repo": "Arbok1"
      }
    ]
  },
  "dependencies": {
    "@ui-sdk/core": "^0.1.0-beta.13",
    "@ui-sdk/react": "^0.1.0-beta.13",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
